    <!-- How it works -->
    <string name="menu_favorites">Favorites</string>
    <string name="menu_how_it_works">How it works</string>
    <string name="menu_help_support">Help &amp; Support</string>
    <string name="how_it_works_title">How it works</string>
    <string name="how_it_works_intro">The menú del día is Barcelona\'s weekday lunch deal: one fixed price for a full meal, served roughly 12:30–16:00, Monday to Friday.</string>
    <string name="how_it_works_included_title">What\'s usually included</string>
    <string name="how_it_works_included_body">A starter, a main, and dessert or coffee — plus bread and a drink. Most places charge €10–€15 for all of it.</string>
    <string name="how_it_works_map_title">Find one near you</string>
    <string name="how_it_works_map_body">The map shows restaurants serving a menú del día today, with the price on the pin and how far away it is. Tap one for today\'s dishes and opening hours.</string>
    <string name="how_it_works_picks_title">Today\'s picks</string>
    <string name="how_it_works_picks_body">Each day at 11:00 we pick three places near you — best rated, best price, and closest — so you don\'t have to decide. Reopen them any time from this menu.</string>
    <string name="how_it_works_filters_title">Narrow it down</string>
    <string name="how_it_works_filters_body">Filter by open now, vegan, gluten free, price, cuisine and walking distance to get to the short list faster.</string>
    <string name="how_it_works_footer">Menús change daily and are set by each restaurant. If something looks wrong, let us know from Send feedback.</string>
